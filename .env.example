# For `python make.py create` (console.anthropic.com -> API keys). Not needed inside Claude Code.
ANTHROPIC_API_KEY=

# Only needed for ElevenLabs voices (elevenlabs.io -> Developers -> API keys)
ELEVENLABS_API_KEY=
# Optional: point at a Rhubarb binary somewhere else
# RHUBARB_PATH=/path/to/rhubarb

# Optional: free Hugging Face token (huggingface.co/settings/tokens) = more GPU quota for the `clone` voice
HF_TOKEN=
